# --- 通知先（run モードで必須） ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# --- 採点（どちらか1つあれば動く。両方入れると片方が落ちても走る） ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# JOBRADAR_OPENAI_MODEL=gpt-4.1-mini
# JOBRADAR_ANTHROPIC_MODEL=claude-sonnet-5
# JOBRADAR_LLM_ORDER=openai,anthropic

# --- 担当者メールのレーン（IMAP。読むだけで既読にも削除にもしない） ---
# アプリパスワードは https://myaccount.google.com/apppasswords で発行する
# （2段階認証が前提。Google Cloud の管理画面は不要で、失効もしない）
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# JOBRADAR_MAIL_DAYS=3

# --- 保存（run モードで必須。preview は DB 不要） ---
DATABASE_URL=postgresql://user:pass@host:5432/jobradar?sslmode=require

# --- Cron の認可。Vercel Cron はこの値を Bearer で送ってくる ---
CRON_SECRET=

# --- Slack のリンク先にする一覧UIのURL（任意） ---
JOBRADAR_DASHBOARD_URL=https://job-radar.vercel.app
